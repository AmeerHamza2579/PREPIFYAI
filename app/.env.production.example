# =========================
# PrepifyAI Production Env
# =========================

# Database (PostgreSQL + pgvector)
# If DB runs in docker-compose service "postgres" on same host:
# This repository's docker-compose maps host 5433 -> container 5432.
# Prefer a dedicated application DB user with least privileges (avoid superuser for app runtime).
DATABASE_URL=postgresql://prepifyai_app:CHANGEME_STRONG_DB_PASSWORD@localhost:5433/PrepifyAI_Main
USE_PGVECTOR=true

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGEME_GENERATE_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage / Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=209715200

# OCR
TESSERACT_PATH=/usr/bin/tesseract
# POPPLER_PATH usually not required on Linux when poppler-utils is installed.
# POPPLER_PATH=

# Optional Redis cache (leave empty to disable Redis cache paths)
# REDIS_URL=redis://localhost:6379/0

# Optional Groq API for LLM-backed endpoints
# GROQ_API_KEY=
GROQ_QUESTION_MODEL=llama-3.1-8b-instant

# Startup behavior
PAST_PAPERS_JSON_AUTOLOAD=false
REQUIRE_GENERATED_QUESTION_APPROVAL=false
DEBUG_API=false

# Default admin bootstrap (development convenience)
# Set true once if you want auto bootstrap, then switch back to false in production.
ENSURE_DEFAULT_ADMIN=false
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=CHANGEME_STRONG_ADMIN_PASSWORD
